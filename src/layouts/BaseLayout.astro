---
import BaseHead from '../components/BaseHead.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, nav } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="メインナビゲーション">
          <ul>
            {
              nav.map((item) => {
                const current =
                  item.href === '/' ? path === '/' : path.startsWith(item.href);
                return (
                  <li>
                    <a href={item.href} aria-current={current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <SocialLinks variant="rail" />

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <SocialLinks variant="row" />
        <p class="small muted">
          © <span data-current-year>{new Date().getFullYear()}</span> {site.name}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.9rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  /* 参考サイトのように、項目の間を細い縦線で区切る */
  nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav li + li {
    border-left: 1px solid var(--border);
  }

  nav a {
    display: block;
    padding-inline: 1rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  nav li:last-child a {
    padding-right: 0;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem 2.5rem;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .footer-inner p {
    margin: 0;
  }

  @media (min-width: 1100px) {
    /* 右端の固定アイコンと重複するのでフッターの横並びは隠す */
    .footer-inner :global(.socials.row) {
      display: none;
    }
  }
</style>
