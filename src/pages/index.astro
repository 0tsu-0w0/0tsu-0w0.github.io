---
import BaseHead from '../components/BaseHead.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, linkButtons } from '../site.config';

const initial = site.name.trim().charAt(0);
---

<html lang="ja">
  <head>
    <BaseHead />
  </head>
  <body class="link-page">
    <main>
      <header class="profile">
        {
          site.avatar && (
            <img
              class="avatar"
              src={site.avatar}
              alt=""
              width="120"
              height="120"
              data-fallbacks="/avatar.jpg,/avatar.jpeg,/avatar.webp"
              onerror="const q = (this.dataset.fallbacks || '').split(',').filter(Boolean); const next = q.shift(); this.dataset.fallbacks = q.join(','); if (next) { this.src = next; } else { this.hidden = true; this.nextElementSibling.hidden = false; }"
            />
          )
        }
        <span class="avatar avatar-fallback" aria-hidden="true" hidden={!!site.avatar}>
          {initial}
        </span>
        <h1>{site.name}</h1>
        {site.nameRoman && <p class="roman">{site.nameRoman}</p>}
        <p class="tagline">{site.tagline}</p>
      </header>

      <SocialLinks variant="row" />

      <nav class="links" aria-label="リンク集">
        <ul>
          {
            linkButtons.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.internal || link.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel={link.internal ? undefined : 'noopener noreferrer'}
                >
                  <span class="label">{link.label}</span>
                  {link.note && <span class="note">{link.note}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </main>

    <footer>
      <p class="small muted">
        © <span data-current-year>{new Date().getFullYear()}</span> {site.copyright}
      </p>
    </footer>
  </body>
</html>

<style>
  .link-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    padding: 4rem 1.25rem 3rem;
    text-align: center;
  }

  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .avatar-fallback {
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 2.75rem;
    color: var(--accent);
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.65rem;
    letter-spacing: 0.06em;
    margin: 1.25rem 0 0;
  }

  .roman {
    margin: 0.15rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tagline {
    margin: 0.6rem 0 1.75rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .links ul {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .links a {
    display: block;
    padding: 0.95rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .links a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .label {
    display: block;
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  footer {
    padding: 1.5rem 1.25rem 2.5rem;
    text-align: center;
  }

  footer p {
    margin: 0;
  }
</style>
