---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, profile } from '../site.config';
---

<BaseLayout title="Profile" description={`${site.name} のプロフィールです。`}>
  <h1>Profile</h1>
  <p class="lede">{site.tagline}</p>

  {profile.bio.map((paragraph) => <p>{paragraph}</p>)}

  <dl class="rows">
    {
      profile.details.map((item) => (
        <div class="row">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>

  {
    profile.history.length > 0 && (
      <>
        <h2>History</h2>
        <dl class="rows">
          {profile.history.map((item) => (
            <div class="row">
              <dt>{item.year}</dt>
              <dd>{item.text}</dd>
            </div>
          ))}
        </dl>
      </>
    )
  }
</BaseLayout>

<style>
  .rows {
    margin: 2.5rem 0 0;
  }

  h2 + .rows {
    margin-top: 1rem;
  }

  .row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 0.5rem 1.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--border);
  }

  dt {
    color: var(--text-muted);
    font-size: 0.9rem;
    letter-spacing: 0.03em;
  }

  dd {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
