---
import { site } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
---

<!-- 保存された配色の選択を、最初の描画より前に <html> へ反映する。
     ここで属性を付けておかないと、読み込み直後に一瞬だけ別の配色が見える。 -->
<script is:inline>
  try {
    const saved = localStorage.getItem('theme');
    if (saved === 'light' || saved === 'dark') {
      document.documentElement.dataset.theme = saved;
    }
  } catch (e) {
    /* 保存領域が使えない環境では OS の設定に従う */
  }
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<meta name="generator" content={Astro.generator} />

<!-- [data-current-year] の中身を閲覧時の年で置き換える。
     静的サイトなのでビルド時の年が埋め込まれるが、年をまたいでも古いままに
     ならないよう、表示のたびに上書きする。 -->
<script>
  const year = String(new Date().getFullYear());
  for (const el of document.querySelectorAll('[data-current-year]')) {
    el.textContent = year;
  }
</script>
