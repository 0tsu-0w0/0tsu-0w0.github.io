---
import { site } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 'website' か、記事なら 'article' */
  type?: 'website' | 'article';
  /** カード画像を差し替えたいとき（省略時はサイト共通の og.png） */
  image?: string;
  /** type が 'article' のときに使う情報 */
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const {
  title,
  description = site.description,
  type = 'website',
  image = site.ogImage,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : site.title;
const base = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, base);
// OGP の画像とリンクは絶対 URL でないと読み取れないサービスが多い
const imageUrl = new URL(image, base);
---

<!-- 保存された配色の選択を、最初の描画より前に <html> へ反映する。
     ここで属性を付けておかないと、読み込み直後に一瞬だけ別の配色が見える。 -->
<script is:inline>
  try {
    const saved = localStorage.getItem('theme');
    if (saved === 'light' || saved === 'dark') {
      document.documentElement.dataset.theme = saved;
    }
  } catch (e) {
    /* 保存領域が使えない環境では OS の設定に従う */
  }
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href={site.avatar} />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<link rel="canonical" href={canonical} />

<!-- ブラウザの UI 色。Android の Chrome や Discord のカードの帯に使われる -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbf9" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16151a" />

<!-- Open Graph。Facebook・LINE・Discord・Slack・Mastodon・Bluesky・はてな等が読む -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />

{
  type === 'article' && (
    <>
      <meta property="article:author" content={site.name} />
      {publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )}
      {modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )}
      {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}

<!-- X のカード。og: だけでも表示されるが、明示しておくと確実 -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitterHandle} />
<meta name="twitter:creator" content={site.twitterHandle} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />

<meta name="generator" content={Astro.generator} />

<!-- [data-current-year] の中身を閲覧時の年で置き換える。
     静的サイトなのでビルド時の年が埋め込まれるが、年をまたいでも古いままに
     ならないよう、表示のたびに上書きする。 -->
<script>
  const year = String(new Date().getFullYear());
  for (const el of document.querySelectorAll('[data-current-year]')) {
    el.textContent = year;
  }
</script>
