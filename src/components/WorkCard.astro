---
interface Props {
  title: string;
  description: string;
  year: number;
  role?: string;
  tech?: string[];
  url?: string;
  repo?: string;
}

const { title, description, year, role, tech = [], url, repo } = Astro.props;
---

<article class="work">
  <header>
    <h3>{url ? <a href={url} rel="noopener noreferrer">{title}</a> : title}</h3>
    <p class="small muted meta">{year}{role ? ` · ${role}` : ''}</p>
  </header>
  <p class="desc">{description}</p>
  {
    tech.length > 0 && (
      <ul class="tags">
        {tech.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )
  }
  {
    repo && (
      <p class="small repo">
        <a href={repo} rel="noopener noreferrer">
          ソースコード
        </a>
      </p>
    )
  }
</article>

<style>
  .work {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.35rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .meta {
    margin: 0;
    white-space: nowrap;
  }

  .desc {
    margin: 0.5rem 0 0.85rem;
    font-size: 0.95rem;
  }

  .repo {
    margin: 0.85rem 0 0;
  }
</style>
